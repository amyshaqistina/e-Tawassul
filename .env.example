APP_NAME="e-Tawassul"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_tawassul
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — for local dev use 'log' to write to storage/logs/laravel.log,
# or configure Mailtrap / SMTP for full email delivery.
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@iium.edu.my"
MAIL_FROM_NAME="${APP_NAME}"

# Blockchain (Quorum). Leave empty for simulation-only mode (recommended for dev).
QUORUM_NODE_URL=
QUORUM_CONTRACT_ADDRESS=
QUORUM_FROM_ADDRESS=
QUORUM_CHAIN_ID=1337
QUORUM_GAS_LIMIT=200000

# iMaalum scraper toggles
IMAALUM_API_BASE=https://api.quddus.my/api
IMAALUM_DIRECTORY_URL=https://www.iium.edu.my/directory/
LECTURER_DIRECTORY_FALLBACK=false
IMAALUM_CACHE_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
